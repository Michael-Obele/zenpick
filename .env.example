# No API keys required.
# Model data is fetched from modelgrep.com (free, no-key API)
# and OpenCode Go (https://opencode.ai/zen/go) public endpoints.

# Optional: web analytics. Set in the Netlify environment to ship the tracker,
# leave empty and no analytics script is emitted.
# VITE_INSIGHTFLARE_SRC=https://<instance>/script.js?siteId=<site id>
